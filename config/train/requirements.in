# Python packages of `satyrn train small` and `satyrn train export`: PyTorch for the CPU,
# transformers, peft (LoRA) and what llama.cpp's GGUF converter needs.
# Update requirements.txt with (see docs/reproducibility.md):
#   uv pip compile config/train/requirements.in --universal --python-version 3.14 --generate-hashes \
#     --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple \
#     --index-strategy unsafe-best-match --emit-index-url -o config/train/requirements.txt
torch
transformers
peft
safetensors
sentencepiece  # llama.cpp's converter imports it before it falls back to the BPE tokenizer (satyrn train export)
